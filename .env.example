# Epilog settings. You normally don't edit this: `epilog setup` fills it in.
# (Copy to .env only if you want to configure things by hand.)

# Meta app (developers.facebook.com → your app → App settings → Basic)
META_APP_ID=
META_APP_SECRET=

# Instagram connection — written by setup
IG_USER_ID=
IG_USERNAME=
IG_ACCESS_TOKEN=
IG_TOKEN_EXPIRES_AT=

# Gmail app password (myaccount.google.com/apppasswords; needs 2-Step Verification)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Optional
# DIGEST_TO=            # send digests somewhere other than GMAIL_ADDRESS (replies must still come from GMAIL_ADDRESS)
# DIGEST_TIME=07:00     # 24-hour local time; re-run `epilog schedule install` after changing
# GRAPH_API_VERSION=v25.0
