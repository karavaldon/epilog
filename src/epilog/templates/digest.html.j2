<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>{{ d.subject }}</title>
</head>
<!-- Web fonts load in Apple Mail and similar; Gmail falls back to the system faces. -->
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<body style="margin:0;padding:0;background:#ffffff;-webkit-text-size-adjust:100%;">
{% set sans = "'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif" %}
{% set mono = "'IBM Plex Mono',ui-monospace,Menlo,Consolas,monospace" %}
{% set serif = "Georgia,'Times New Roman',serif" %}
{% set ink = "#000000" %}
{% set muted = "#4a4a55" %}
{% set faint = "#7b7b8a" %}
{% set accent = "#5760dd" %}
<div style="display:none;max-height:0;overflow:hidden;mso-hide:all;">
  {{ d.preheader }}{% for _ in range(80) %}&#8199;&#847;{% endfor %}
</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#ffffff;">
<tr><td align="center" style="padding:32px 16px 48px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:{{ post_width }}px;">

  <!-- Masthead -->
  <tr><td style="padding:0 0 28px;">
    <div style="font-family:{{ serif }};font-size:56px;line-height:1;color:{{ ink }};" aria-label="Epilog">⁕</div>
    <div style="font-family:{{ mono }};font-size:12px;line-height:1.5;color:{{ muted }};text-transform:uppercase;letter-spacing:0.06em;padding-top:10px;">
      {{ d.generated_at.strftime("%A, %B %-d") }}
      {% if d.post_count %} · {{ d.post_count }} new post{{ "s" if d.post_count != 1 }} from {{ d.accounts|length }} account{{ "s" if d.accounts|length != 1 }}{% endif %}
    </div>
  </td></tr>

  {% for n in d.notices %}
  <tr><td style="padding:0 0 20px;">
    <div style="font-family:{{ sans }};font-size:14px;line-height:1.5;color:{{ ink }};background:#f2f2f2;border:2px solid {{ ink }};padding:12px 14px;">{{ n }}</div>
  </td></tr>
  {% endfor %}

  {% if not d.post_count %}
  <tr><td style="font-family:{{ sans }};font-size:15px;color:{{ muted }};">No new posts since the last digest.</td></tr>
  {% endif %}

  {% for a in d.accounts %}
  <!-- @{{ a.username }} -->
  {% if not loop.first %}
  <tr><td style="padding:4px 0 28px;"><div style="height:2px;line-height:2px;font-size:0;background:#e0e0e0;">&nbsp;</div></td></tr>
  {% endif %}
  <tr><td style="padding:0 0 12px;">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
      <td width="36" style="padding-right:10px;vertical-align:middle;">
        {% set av = img.get("avatar-" ~ a.username) %}
        {% if av %}
        <img src="{{ av.src }}" width="36" height="36" alt="" style="display:block;width:36px;height:36px;border-radius:18px;">
        {% else %}
        <div style="width:36px;height:36px;border-radius:18px;background:#ebebeb;"></div>
        {% endif %}
      </td>
      <td style="vertical-align:middle;font-family:{{ sans }};">
        <div style="color:{{ ink }};font-size:15px;font-weight:600;line-height:1.2;">{{ a.name }}</div>
        <div style="font-family:{{ mono }};font-size:12px;color:{{ muted }};line-height:1.4;">@{{ a.username }} · {{ a.posts|length }} new</div>
      </td>
    </tr></table>
  </td></tr>

  {% for p in a.posts %}
  {% set items = media.get(p.id, []) %}
  <tr><td style="padding:0 0 28px;">
    {% for m in items %}
    {% set spacing = "margin-top:" ~ gap ~ "px;" if not loop.first else "" %}
    {% if m.is_video %}
    <div style="text-align:center;line-height:0;background:#f2f2f2;{{ spacing }}">
      <a href="{{ m.href }}" style="display:inline-block;line-height:0;"><img src="{{ m.src }}" width="{{ m.width }}" height="{{ m.height }}" alt="Play in app: video by @{{ a.username }}" style="display:inline-block;width:{{ m.width }}px;max-width:100%;height:auto;border:0;"></a>
    </div>
    {% else %}
    <a href="{{ m.href }}" style="display:block;line-height:0;{{ spacing }}"><img src="{{ m.src }}" width="{{ m.width }}" alt="{{ 'Photo ' ~ loop.index ~ ' of ' ~ p.count if p.kind == 'carousel' else 'Post' }} by @{{ a.username }}" style="display:block;width:100%;max-width:{{ m.width }}px;height:auto;border:0;"></a>
    {% endif %}
    {% endfor %}
    <div style="font-family:{{ sans }};padding-top:{{ '10px' if items else '0' }};">
      <a href="{{ p.permalink }}" style="font-family:{{ mono }};font-size:11px;line-height:1.4;color:{{ faint }};text-transform:uppercase;letter-spacing:0.08em;text-decoration:none;">
        {{ p.timestamp|when }}{% if p.kind == "video" %} · Video{% elif p.kind == "carousel" %} · {{ p.count }} photos{% endif %}
      </a>
      {% if p.caption %}
      <div style="font-size:14px;line-height:1.5;color:{{ ink }};padding-top:4px;">{{ p.caption|nl2br }}</div>
      {% endif %}
    </div>
  </td></tr>
  {% endfor %}
  {% endfor %}

  <!-- Footer -->
  <tr><td style="padding:24px 0 0;font-family:{{ mono }};font-size:12px;line-height:1.7;color:{{ faint }};border-top:2px solid #e0e0e0;">
    {% if d.failed %}
    <div style="padding-bottom:8px;">Couldn't reach {% for u, err in d.failed %}@{{ u }}{% if not loop.last %}, {% endif %}{% endfor %} today (connection problem). Their new posts will be in the next digest.</div>
    {% endif %}
    <div style="padding-bottom:14px;">To add accounts, reply to this email with their handles, one per line (“add @handle” works too). To stop following one, reply “remove @handle”. Accounts must be Creators or Businesses.</div>
    {% if d.unsupported %}
    <div style="padding-bottom:14px;">These Personal accounts are not available: {% for u in d.unsupported %}@{{ u }}{% if not loop.last %}, {% endif %}{% endfor %}</div>
    {% endif %}
    <div style="padding-bottom:14px;">⁕ Epilog is a free, open-source project using Instagram’s official API</div>
    <div>© 2026 · v{{ version }} · Made by <a href="https://karavaldon.com/epilog" style="color:{{ accent }};text-decoration:underline;">K.V.</a></div>
  </td></tr>

</table>
</td></tr>
</table>
</body>
</html>
